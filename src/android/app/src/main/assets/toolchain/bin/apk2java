#!/bin/sh
# apk2java — one command: APK -> smali + Java sources.
#   apk2java target.apk [outdir]
# Produces:
#   outdir/smali/   apktool output (smali, res, AndroidManifest.xml)
#   outdir/java/    jadx output (fallback: dex2jar + cfr)
set -e
TC=/var/minis/toolchain
JADX_JAR="$TC/jars/jadx-1.5.1-all.jar"

APK="$1"
if [ -z "$APK" ] || [ ! -f "$APK" ]; then
    echo "usage: apk2java <file.apk> [outdir]" >&2
    exit 2
fi

case "$APK" in
    /*) APKABS="$APK" ;;
    *)  APKABS="$(pwd)/$APK" ;;
esac
OUT="${2:-${APK%.apk}_src}"
mkdir -p "$OUT"

echo "[1/2] apktool decode -> $OUT/smali"
java -Xmx2g -jar "$TC/jars/apktool.jar" d -f -o "$OUT/smali" "$APKABS" >/dev/null

echo "[2/2] jadx -> $OUT/java"
mkdir -p "$OUT/java"
if [ -f "$JADX_JAR" ]; then
    java -Xmx2560m -cp "$JADX_JAR" jadx.cli.JadxCLI -d "$OUT/java" --no-res "$APKABS" \
        >/dev/null 2>&1 || true
fi

if ! find "$OUT/java" -name '*.java' 2>/dev/null | head -1 | grep -q .; then
    echo "      jadx produced nothing, falling back to dex2jar + cfr"
    TMP="$OUT/.dex"
    rm -rf "$TMP"
    mkdir -p "$TMP"
    (
        cd "$TMP" || exit 1
        unzip -oq "$APKABS" 'classes*.dex' 2>/dev/null || true
        for d in classes*.dex; do
            [ -f "$d" ] || continue
            java -Xmx2g -cp "$TC/jars/d2j/*" \
                com.googlecode.dex2jar.tools.Dex2jarCmd "$d" -o "${d%.dex}.jar" >/dev/null
        done
    )
    for j in "$TMP"/*.jar; do
        [ -f "$j" ] || continue
        java -Xmx2g -jar "$TC/jars/cfr.jar" "$j" --outputdir "$OUT/java" >/dev/null 2>&1 || true
    done
    rm -rf "$TMP"
fi

echo "done:"
echo "  smali : $OUT/smali"
echo "  java  : $OUT/java"
